{
  "$description": "Mnemosyne design tokens. Source of truth. Mirrored in prototype/css/tokens.css and design/tailwind.preset.js. Contrast ratios are WCAG 2.x against bg / worst-case surface.",
  "color": {
    "bg":             { "value": "#0A0806", "use": "page" },
    "surface-1":      { "value": "#0C0906", "use": "graph canvas, terminal logs, drop zone" },
    "surface-2":      { "value": "#0D0A07", "use": "rails, inspector, query band, stepper" },
    "surface-3":      { "value": "#0F0B07", "use": "inputs, cards, status line, idle results" },
    "surface-raised": { "value": "#15100A", "use": "active rows, toggled filters" },
    "surface-drag":   { "value": "#1A140B", "use": "drop target while dragging" },
    "line-soft":      { "value": "#241A0B", "use": "row dividers" },
    "line":           { "value": "#3D2C10", "use": "panel borders, idle buttons" },
    "line-strong":    { "value": "#7A5715", "use": "idle node borders, dashed chips; never text", "contrast": 3.05 },
    "amber":          { "value": "#FFB000", "use": "primary ink, brand, active fills", "contrast": [10.91, 10.32] },
    "amber-hi":       { "value": "#FFD27A", "use": "emphasis, values, selected labels", "contrast": [14.05, 13.29] },
    "amber-mid":      { "value": "#E0A12A", "use": "idle node labels, chip text", "contrast": [8.86, 8.38] },
    "amber-dim":      { "value": "#C98C1A", "use": "secondary text", "contrast": [6.90, 6.53] },
    "amber-muted":    { "value": "#A27A36", "use": "tertiary text, labels, prompts", "contrast": [5.12, 4.68] },
    "prose":          { "value": "#F2D49B", "use": "long-form reading text", "contrast": [13.96, 13.21] },
    "hot":            { "value": "#FF5A1F", "use": "warnings, open flags, weaknesses, low confidence, demo badge", "contrast": [6.41, 6.06] },
    "on-amber":       { "value": "#0A0806", "use": "text on amber fills", "contrast": 10.91 }
  },
  "shadow": {
    "glow-text":   { "value": "0 0 10px rgba(255,176,0,0.40)", "use": "wordmark, solution headline" },
    "glow-select": { "value": "0 0 18px rgba(255,176,0,0.45)", "use": "selected node, focused prompt, palette" },
    "glow-panel":  { "value": "0 0 22px rgba(255,176,0,0.15)", "use": "primary input at rest, #1 result card" },
    "glow-line":   { "value": "0 0 6px rgba(255,176,0,0.60)",  "use": "highlighted edges, progress bar" }
  },
  "font": {
    "display": { "value": "'VT323', ui-monospace, 'Cascadia Mono', Menlo, monospace", "use": "wordmark and display titles only, ≥36px" },
    "ui":      { "value": "'IBM Plex Mono', ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace", "weights": [400, 500, 600] },
    "prose":   { "value": "'IBM Plex Sans', 'Segoe UI', system-ui, -apple-system, sans-serif", "weights": [400, 500] }
  },
  "fontSize": {
    "micro": { "value": "11px", "use": "system labels, caps, tracking 0.2em" },
    "xs":    { "value": "12px", "use": "meta, badges, buttons" },
    "sm":    { "value": "13px", "use": "dense UI, logs, status line" },
    "base":  { "value": "14px", "use": "default UI" },
    "md":    { "value": "15px", "use": "inspector prose, result titles" },
    "prose": { "value": "17px", "lineHeight": 1.7, "use": "codex article body" },
    "lg":    { "value": "20px", "use": "query prompt" },
    "d1":    { "value": "38px", "use": "wordmark (VT323, tracking 0.18em)" },
    "d2":    { "value": "44px", "use": "panel titles (VT323)" },
    "d3":    { "value": "52px", "use": "solution headline (VT323)" },
    "d4":    { "value": "72px", "use": "codex title (VT323); 52px on phones" }
  },
  "letterSpacing": { "label": "0.2em", "button": "0.14em", "brand": "0.18em" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "28px", "8": "32px", "10": "40px", "16": "64px" },
  "size": { "hit": "44px", "hit-sm": "36px", "rail-left": "220px", "rail-right": "320px", "measure": "760px" },
  "radius": { "value": "0", "note": "No rounding anywhere." },
  "motion": {
    "fast":   { "value": "150ms", "use": "hover, border color" },
    "base":   { "value": "200ms", "use": "selection, dimming" },
    "layout": { "value": "420ms", "use": "graph layout transitions, progress" },
    "ease":   { "value": "cubic-bezier(.2,.7,.2,1)" },
    "reducedMotion": "all durations 0; cursor static; scanlines off"
  },
  "nodeType": {
    "game":      { "tag": "GME", "border": "3px double" },
    "strategy":  { "tag": "STR", "border": "1px solid" },
    "archetype": { "tag": "ARC", "border": "2px solid" },
    "mechanism": { "tag": "MEC", "border": "1px dashed" },
    "guide":     { "tag": "GDE", "border": "2px dashed" },
    "source":    { "tag": "SRC", "border": "1px dotted" }
  },
  "texture": {
    "scanlines": "repeating-linear-gradient(0deg, rgba(0,0,0,0.22) 0, rgba(0,0,0,0.22) 1px, transparent 1px, transparent 3px)",
    "grid": "40px amber grid at 5% opacity, graph canvas only"
  }
}
