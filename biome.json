{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "src/flashpoint/web/static/**/*.js",
      "src/flashpoint/web/static/**/*.css",
      "!src/flashpoint/web/static/vendor",
      "!src/flashpoint/web/static/mode.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" },
    "globals": ["FP", "FP_MODE", "uPlot"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUndeclaredVariables": "error" },
      "suspicious": { "noRedundantUseStrict": "off" },
      "style": { "useTemplate": "off" }
    }
  }
}
